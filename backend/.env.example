# ============================================================
# Backend (local ou Render)
# ============================================================

# Banco de dados
# - Neon (produção): cole a connection string do painel.
#   Use a "pooled" e mantenha o ?sslmode=require (o Neon exige SSL).
#   Ex.: postgresql://user:password@ep-xxx.aws.neon.tech/db?sslmode=require
# - Local (docker compose): postgresql://dharma:dharma@localhost:5433/dharma
DATABASE_URL=postgresql://user:password@host:5432/dharma?sslmode=require

# CORS: origens liberadas para a API, separadas por vírgula
# Em produção, inclua a URL do projeto da Vercel (ex.: https://dharma.vercel.app)
ALLOWED_ORIGINS=http://localhost:3003,https://SEU-PROJETO.vercel.app
